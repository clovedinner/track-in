generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

enum CampaignStatus {
  active
  paused
  archived

  @@map("campaign_status")
}

enum CampaignTrackingMode {
  redirect
  direct

  @@map("campaign_tracking_mode")
}

enum OutboundPostbackStatus {
  pending
  processing
  delivered
  retryable_failed
  permanently_failed
  suppressed

  @@map("outbound_postback_status")
}

enum AccountStatus {
  payment_required
  active
  past_due
  suspended
  canceled

  @@map("account_status")
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  expired

  @@map("subscription_status")
}

enum BillingPaymentStatus {
  pending
  confirmed
  failed
  refunded

  @@map("billing_payment_status")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  accountStatus AccountStatus @default(payment_required) @map("account_status")
  timezone String @default("UTC") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  campaigns    Campaign[]
  offers       Offer[]
  trafficSources TrafficSource[]
  subscriptions Subscription[]
  payments      BillingPayment[]
  billingEvents BillingEvent[]
  customConversions CustomConversion[]

  @@map("users")
}

model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  plan               String
  status             SubscriptionStatus @default(active)
  provider           String
  externalId         String?            @map("external_id")
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  nextInvoiceAt      DateTime?          @map("next_invoice_at") @db.Timestamptz(6)
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments           BillingPayment[]

  @@index([userId, status])
  @@index([currentPeriodEnd])
  @@unique([provider, externalId])
  @@map("subscriptions")
}

model BillingPayment {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                @map("user_id") @db.Uuid
  subscriptionId        String?               @map("subscription_id") @db.Uuid
  invoiceId             String                @unique @map("invoice_id")
  provider              String
  plan                  String
  amountMinor           BigInt                @map("amount_minor")
  currency              String                @db.VarChar(10)
  network               String?
  status                BillingPaymentStatus @default(pending)
  providerTransactionId String?               @map("provider_transaction_id")
  transactionHash       String?               @map("transaction_hash")
  receivedAt            DateTime?             @map("received_at") @db.Timestamptz(6)
  confirmedAt           DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  failureReason         String?               @map("failure_reason")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription          Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([providerTransactionId])
  @@index([transactionHash])
  @@map("billing_payments")
}

model BillingEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  payloadHash String    @map("payload_hash") @db.Char(64)
  status      String    @default("received")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("billing_events")
}

model TrafficSource {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId             String             @map("owner_id") @db.Uuid
  name                String
  type                String
  enabled             Boolean            @default(true)
  credentialSecretRef String?            @map("credential_secret_ref")
  configuration       Json               @default("{}")
  retryPolicy         Json               @default("{}") @map("retry_policy")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  campaigns           Campaign[]
  clicks              Click[]
  outboundPostbacks   OutboundPostback[]
  owner               User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@unique([ownerId, name])
  @@map("traffic_sources")
}

model Campaign {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId                   String         @map("owner_id") @db.Uuid
  slug                      String
  name                      String
  status                    CampaignStatus @default(active)
  trackingMode              CampaignTrackingMode @default(redirect) @map("tracking_mode")
  destinationUrl            String         @map("destination_url")
  trafficSourceId           String?        @map("traffic_source_id") @db.Uuid
  offerId                   String?        @map("offer_id") @db.Uuid
  defaultCurrency           String         @map("default_currency") @db.Char(3)
  allowedTrackingParameters Json           @default("[]") @map("allowed_tracking_parameters")
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt                DateTime?      @map("archived_at") @db.Timestamptz(6)
  trafficSource             TrafficSource? @relation(fields: [trafficSourceId], references: [id], onDelete: Restrict)
  offer                     Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  clicks                    Click[]
  owner                     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@unique([slug])
  @@index([trafficSourceId])
  @@index([offerId])
  @@map("campaigns")
}

model Offer {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String     @map("owner_id") @db.Uuid
  name              String
  offerUrl          String?    @map("offer_url")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  campaigns         Campaign[]
  owner             User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@unique([ownerId, name])
  @@map("offers")
}

model CustomConversion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId            String   @map("owner_id") @db.Uuid
  name               String
  eventValues        String[] @default([]) @map("event_values")
  includeInConversions Boolean @default(true) @map("include_in_conversions")
  includeInRevenue   Boolean  @default(false) @map("include_in_revenue")
  sendPostbackToTrafficSource Boolean @default(false) @map("send_postback_to_traffic_source")
  includeInCost       Boolean  @default(false) @map("include_in_cost")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner               User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt(sort: Desc)])
  @@unique([ownerId, name])
  @@map("custom_conversions")
}

model Click {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clickId         String         @unique @map("click_id")
  campaignId      String         @map("campaign_id") @db.Uuid
  trafficSourceId String?        @map("traffic_source_id") @db.Uuid
  clickedAt       DateTime       @default(now()) @map("clicked_at") @db.Timestamptz(6)
  ipAddress       String?        @map("ip_address") @db.Inet
  userAgent       String?        @map("user_agent")
  referrer        String?
  destinationUrl  String         @map("destination_url")
  trackingTokens  Json           @default("{}") @map("tracking_tokens")
  correlationId   String         @map("correlation_id") @db.Uuid
  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  trafficSource   TrafficSource? @relation(fields: [trafficSourceId], references: [id], onDelete: Restrict)
  conversions     Conversion[]

  @@index([campaignId, clickedAt(sort: Desc)])
  @@index([trafficSourceId, clickedAt(sort: Desc)])
  @@map("clicks")
}

model Conversion {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clickRecordId        String             @map("click_record_id") @db.Uuid
  source               String
  eventId              String             @map("event_id")
  eventType            String             @map("event_type")
  occurredAt           DateTime           @map("occurred_at") @db.Timestamptz(6)
  receivedAt           DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  valueMinor           BigInt             @map("value_minor")
  currency             String             @db.Char(3)
  transactionReference String?            @map("transaction_reference")
  payloadHash          String             @map("payload_hash") @db.Char(64)
  validationState      String             @default("accepted") @map("validation_state")
  correlationId        String             @map("correlation_id") @db.Uuid
  click                Click               @relation(fields: [clickRecordId], references: [id], onDelete: Restrict)
  outboundPostbacks    OutboundPostback[]

  @@unique([source, eventId])
  @@index([clickRecordId])
  @@index([receivedAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("conversions")
}

model OutboundPostback {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversionId        String                 @map("conversion_id") @db.Uuid
  trafficSourceId     String                 @map("traffic_source_id") @db.Uuid
  destination         String
  status              OutboundPostbackStatus @default(pending)
  attemptCount        Int                    @default(0) @map("attempt_count")
  nextAttemptAt       DateTime               @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedAt            DateTime?              @map("locked_at") @db.Timestamptz(6)
  lockedBy            String?                @map("locked_by")
  requestFingerprint  String?                @map("request_fingerprint") @db.Char(64)
  lastResponseStatus  Int?                   @map("last_response_status")
  lastResponseSummary String?                @map("last_response_summary")
  lastError           String?                @map("last_error")
  deliveredAt         DateTime?              @map("delivered_at") @db.Timestamptz(6)
  correlationId       String                 @map("correlation_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  conversion          Conversion             @relation(fields: [conversionId], references: [id], onDelete: Restrict)
  trafficSource       TrafficSource          @relation(fields: [trafficSourceId], references: [id], onDelete: Restrict)

  @@unique([conversionId, trafficSourceId, destination])
  @@index([conversionId])
  @@index([status, nextAttemptAt])
  @@map("outbound_postbacks")
}

model AuditEntry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  actor         String
  metadata      Json     @default("{}")
  correlationId String   @map("correlation_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_entries")
}
