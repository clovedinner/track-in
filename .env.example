# Public origin used when constructing application URLs outside an incoming request.
# Production must use the canonical HTTPS origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional dedicated tracking origin. Leave empty locally to use NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_TRACKER_URL=

# Neon pooled connection string used by the application at runtime.
DATABASE_URL=postgresql://user:password@ep-example-pooler.aws.neon.tech/neondb?sslmode=require

# Neon direct connection string used only by Prisma migrations and Studio.
DIRECT_URL=postgresql://user:password@ep-example.aws.neon.tech/neondb?sslmode=require

# Dashboard session and server-to-server conversion authentication.
# Use long, unique values outside local development. Generate a session secret
# with: openssl rand -base64 32
AUTH_SESSION_SECRET=change-me-to-a-random-32-character-secret
ADMIN_USERNAME=operator
ADMIN_PASSWORD=change-me-before-production
CONVERSION_WEBHOOK_SECRET=change-me-before-production

# Transactional email through Resend. Add trakio.org to Resend and publish its DNS records first.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_VERIFICATION=Trakio <team@trakio.org>
EMAIL_FROM_INVOICE=Trakio Billing <billing@trakio.org>
EMAIL_POLL_INTERVAL_MS=5000

# Automatic USDT payments on TRON. Create a free API key at https://www.trongrid.io/.
# The wallet address is public and receives payments; never put its private key here.
BILLING_PROVIDER=tron
BILLING_WALLET_ADDRESS=replace-with-your-tron-wallet-address
TRONGRID_API_KEY=replace-with-your-trongrid-api-key
BILLING_POLL_INTERVAL_MS=15000
BILLING_TEST_MODE=false
